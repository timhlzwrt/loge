diff --git a/video/out/vulkan/context_moltenvk.m b/video/out/vulkan/context_moltenvk.m
index 445b907..9f56390 100644
--- a/video/out/vulkan/context_moltenvk.m
+++ b/video/out/vulkan/context_moltenvk.m
@@ -23,14 +23,36 @@
 #include "context.h"
 #include "utils.h"
 
+// Wakes the VO thread when the embedding app resizes the layer. Playback would
+// notice on the next frame anyway, but while paused nothing else wakes the thread.
+@interface MPVMoltenVKLayerObserver : NSObject {
+@public
+    struct vo *vo;
+}
+@end
+
+@implementation MPVMoltenVKLayerObserver
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object
+                        change:(NSDictionary *)change context:(void *)context
+{
+    vo_wakeup(vo);
+}
+@end
+
 struct priv {
     struct mpvk_ctx vk;
     CAMetalLayer *layer;
+    MPVMoltenVKLayerObserver *observer;
 };
 
 static void moltenvk_uninit(struct ra_ctx *ctx)
 {
     struct priv *p = ctx->priv;
+    if (p->observer) {
+        [p->layer removeObserver:p->observer forKeyPath:@"drawableSize"];
+        [p->observer release];
+        p->observer = nil;
+    }
     ra_vk_ctx_uninit(ctx);
     mpvk_uninit(&p->vk);
 }
@@ -67,6 +89,10 @@ static bool moltenvk_init(struct ra_ctx *ctx)
     if (!ra_vk_ctx_init(ctx, vk, params, VK_PRESENT_MODE_FIFO_KHR))
         goto fail;
 
+    p->observer = [[MPVMoltenVKLayerObserver alloc] init];
+    p->observer->vo = ctx->vo;
+    [p->layer addObserver:p->observer forKeyPath:@"drawableSize" options:0 context:NULL];
+
     return true;
 fail:
     moltenvk_uninit(ctx);
@@ -83,6 +109,20 @@ static bool moltenvk_reconfig(struct ra_ctx *ctx)
 
 static int moltenvk_control(struct ra_ctx *ctx, int *events, int request, void *arg)
 {
+    struct priv *p = ctx->priv;
+    switch (request) {
+    case VOCTRL_CHECK_EVENTS: {
+        // The embedding app resizes the layer (rotation, window resize); pick up
+        // the new drawable size like the other contexts do on window events.
+        CGSize s = p->layer.drawableSize;
+        if (s.width > 0 && s.height > 0 &&
+            (s.width != ctx->vo->dwidth || s.height != ctx->vo->dheight)) {
+            moltenvk_reconfig(ctx);
+            *events |= VO_EVENT_RESIZE;
+        }
+        return VO_TRUE;
+    }
+    }
     return VO_NOTIMPL;
 }
 
